---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import en from '../../locales/en.json';
import de from '../../locales/de.json';
import '../styles/global.css';

const { title, description, activePage, lang, trackLang = true } = Astro.props;
const locales = { en, de };
const t = locales[lang] || en;

const path = Astro.url.pathname;
const altPath = (targetLang) => path.replace(/^\/(en|de)(?=\/|$)/, `/${targetLang}`);
const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL('/og-image.jpg', Astro.site);
const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';
const ogLocaleAlternate = lang === 'de' ? 'en_US' : 'de_DE';

const personSchema = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Felix Jonas Wiegleb',
    jobTitle: 'Fullstack Software Developer',
    url: 'https://mathia.xyz',
    image: ogImageURL.toString(),
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'Leipzig',
        addressCountry: 'DE',
    },
    sameAs: [
        'https://github.com/LeTammo/',
        'https://www.linkedin.com/in/jwiegleb',
    ],
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#09090b" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}

        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={new URL(altPath('en'), Astro.site)} />
        <link rel="alternate" hreflang="de" href={new URL(altPath('de'), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(altPath('en'), Astro.site)} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="mathia.xyz" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlternate} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={ogImageURL} />

        <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

        {trackLang && (
            <script is:inline define:vars={{ lang }}>
                try {
                    document.cookie = 'preferredLang=' + lang + ';path=/;max-age=31536000;samesite=lax';
                } catch (e) {}
            </script>
        )}

        <ClientRouter />
        <script is:inline src="/js/sketch.js" defer></script>
    </head>
    <body class="page-body">
        <div id="p5-bg" transition:persist="p5-bg"></div>
        <div class="page-container">
            <div class="page-inner">
                <aside class="page-aside">
                    <div class="nav-panel shadow-bottom">
                        <Navigation activePage={activePage} lang={lang} t={t} />
                    </div>
                </aside>
                <main role="main" class="main-panel">
                    <slot />
                </main>
            </div>
        </div>
        <footer class="page-footer shadow-top">
            <Footer lang={lang} t={t} />
        </footer>
    </body>
</html>

<style>
    .page-body {
        display: flex;
        flex-direction: column;
        height: 100%;
        margin: 0;
        padding: 0;
        background: linear-gradient(to right, var(--bg-canvas-from), var(--bg-canvas-to));
        color: var(--text-tertiary);
    }

    .page-container {
        flex-grow: 1;
        padding-bottom: calc(4rem + env(safe-area-inset-bottom));
    }

    @media (min-width: 640px) {
        .page-container {
            padding: 1.5rem 1.5rem calc(4rem + env(safe-area-inset-bottom));
        }
    }

    @media (min-width: 768px) {
        .page-container {
            max-width: 768px;
            margin-inline: auto;
            padding: 2.5rem 2.5rem calc(4rem + env(safe-area-inset-bottom));
        }
    }

    @media (min-width: 1024px) {
        .page-container {
            max-width: 1024px;
        }
    }

    @media (min-width: 1280px) {
        .page-container {
            max-width: 1280px;
            padding: 5rem 5rem calc(4rem + env(safe-area-inset-bottom));
        }
    }

    @media (min-width: 1540px) {
        .page-container {
            max-width: 1540px;
        }
    }

    .page-inner {
        display: flex;
        flex-direction: column;
    }

    .page-aside {
        position: sticky;
        z-index: 10;
        width: 100%;
        padding-bottom: 0.75rem;
    }

    @media (min-width: 640px) {
        .page-aside {
            padding-bottom: 1rem;
            padding-inline: 0;
        }
    }

    @media (min-width: 1280px) {
        .page-aside {
            top: -0.25rem;
        }
    }

    .nav-panel {
        width: 100%;
        padding: 0.5rem;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-default);
    }

    @media (min-width: 640px) {
        .nav-panel {
            border: 1px solid var(--border-default);
            border-radius: var(--radius-xl);
        }
    }

    @media (min-width: 1280px) {
        .nav-panel {
            padding: 0.75rem;
        }
    }

    .main-panel {
        width: 100%;
        background: var(--bg-surface);
        padding: 1.25rem;
    }

    @media (min-width: 640px) {
        .main-panel {
            padding: 2rem;
            border: 1px solid var(--border-default);
            border-radius: var(--radius-xl);
        }
    }

    @media (min-width: 768px) {
        .main-panel {
            padding: 2.5rem;
        }
    }

    .page-footer {
        position: fixed;
        bottom: 0;
        width: 100%;
    }
</style>
