---
import Layout from '../../layouts/Layout.astro';
import en from '../../../locales/en.json';
import de from '../../../locales/de.json';

export function getStaticPaths() {
    return [
        {params: {lang: 'en'}},
        {params: {lang: 'de'}},
    ];
}

const {lang} = Astro.params;
const locales = {en, de};
const t = locales[lang] || en;
---

<Layout title={`${t.errors.title404} | mathia.xyz`} description={t.errors.description404} lang={lang}>
    <div class="error-page">
        <p class="error-code">404</p>
        <div class="error-block">
            <h1 class="error-title">{t.errors.title404}</h1>
            <p class="error-description">{t.errors.description404}</p>
        </div>
        <a href={`/${lang}`} class="error-cta">
            {t.impressum.backHome}
        </a>
    </div>
</Layout>
