---
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocalePaths, useTranslations } from '../../i18n.js';

export function getStaticPaths() {
    return getLocalePaths();
}

const lang = Astro.currentLocale;
const t = useTranslations(lang);
---

<Layout title={`${t.errors.title404} | mathia.xyz`} description={t.errors.description404}>
    <div class="error-page">
        <p class="error-code">404</p>
        <div class="error-block">
            <h1 class="error-title">{t.errors.title404}</h1>
            <p class="error-description">{t.errors.description404}</p>
        </div>
        <a href={getRelativeLocaleUrl(lang)} class="error-cta">
            {t.impressum.backHome}
        </a>
    </div>
</Layout>
