---
import Layout from '../../layouts/Layout.astro';
import Education from '../../components/about/Education.astro';
import Work from '../../components/about/Work.astro';
import Prework from '../../components/about/Prework.astro';
import { Image } from 'astro:assets';
import en from '../../../locales/en.json';
import de from '../../../locales/de.json';
import meImg from '../../images/me.jpg';

export function getStaticPaths() {
    return [
        {params: {lang: 'en'}},
        {params: {lang: 'de'}},
    ];
}

const {lang} = Astro.params;
const locales = {en, de};
const t = locales[lang] || en;
---

<Layout title={t.meta.titleExperience} description={t.meta.descriptionExperience} activePage="berufserfahrung" lang={lang}>
    <div class="experience-intro">
        <div class="page-header">
            <a href={`/${lang}`} class="page-header__avatar" transition:name="profile-image" aria-label={t.about.title}>
                <Image src={meImg} alt="Felix Jonas Wiegleb" width={128} loading="eager" />
            </a>
            <h1 class="page-title">{t.about.work}</h1>
        </div>
    </div>

    <div class="experience-grid">
        <div>
            <Education t={t} />
        </div>
        <div>
            <Work t={t} />
        </div>
        <div>
            <Prework t={t} />
        </div>
    </div>
</Layout>

<style>
    .experience-intro {
        margin-bottom: 2.5rem;
    }

    .experience-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
    }

    @media (min-width: 1024px) {
        .experience-grid {
            grid-template-columns: 2fr 5fr 4fr;
            gap: 2rem;
        }
    }

    @media (min-width: 1280px) {
        .experience-grid {
            gap: 4rem;
        }
    }
</style>
