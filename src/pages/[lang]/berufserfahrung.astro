---
import Layout from '../../layouts/Layout.astro';
import Education from '../../components/about/Education.astro';
import Work from '../../components/about/Work.astro';
import Prework from '../../components/about/Prework.astro';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocalePaths, useTranslations } from '../../i18n.js';
import meImg from '../../images/me.jpg';

export function getStaticPaths() {
    return getLocalePaths();
}

const lang = Astro.currentLocale;
const t = useTranslations(lang);
---

<Layout title={t.meta.titleExperience} description={t.meta.descriptionExperience} activePage="berufserfahrung">
    <div class="experience-intro">
        <div class="page-header">
            <a href={getRelativeLocaleUrl(lang)} class="page-header__avatar" transition:name="profile-image" aria-label={t.about.title}>
                <Image src={meImg} alt="Felix Jonas Wiegleb" width={64} height={64} layout="fixed" loading="eager" />
            </a>
            <h1 class="page-title">{t.about.work}</h1>
        </div>
    </div>

    <div class="experience-grid">
        <div>
            <Education />
        </div>
        <div>
            <Work />
        </div>
        <div>
            <Prework />
        </div>
    </div>
</Layout>

<style>
    .experience-intro {
        margin-bottom: 2.5rem;
    }

    .experience-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
    }

    @media (min-width: 1024px) {
        .experience-grid {
            grid-template-columns: 2fr 5fr 4fr;
            gap: 2rem;
        }
    }

    @media (min-width: 1280px) {
        .experience-grid {
            gap: 4rem;
        }
    }
</style>
