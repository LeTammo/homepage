---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/home/Hero.astro';
import SkillsExperience from '../../components/home/SkillsExperience.astro';
import { getLocalePaths, useTranslations } from '../../i18n.js';

export function getStaticPaths() {
    return getLocalePaths();
}

const t = useTranslations(Astro.currentLocale);
---

<Layout title={t.meta.titleHome} description={t.meta.descriptionHome} activePage="home">
    <div>
        <Hero />
    </div>
    <div class="home-skills">
        <SkillsExperience />
    </div>
</Layout>

<style>
    .home-skills {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-default);
    }
</style>
