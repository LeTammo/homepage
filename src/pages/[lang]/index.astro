---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/home/Hero.astro';
import SkillsExperience from '../../components/home/SkillsExperience.astro';
import en from '../../../locales/en.json';
import de from '../../../locales/de.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const locales = { en, de };
const t = locales[lang] || en;
---

<Layout title={t.meta.titleHome} description={t.meta.descriptionHome} activePage="home" lang={lang}>
    <div>
        <Hero lang={lang} t={t} />
    </div>
    <div class="home-skills">
        <SkillsExperience lang={lang} t={t} />
    </div>
</Layout>

<style>
    .home-skills {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-default);
    }
</style>
