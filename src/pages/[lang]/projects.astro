---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import en from '../../../locales/en.json';
import de from '../../../locales/de.json';
import meImg from '../../images/me.jpg';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
    return [
        {params: {lang: 'en'}},
        {params: {lang: 'de'}},
    ];
}

const {lang} = Astro.params;
const locales = {en, de};
const t = locales[lang] || en;
---

<Layout title={t.meta.titleProjects} description={t.meta.descriptionProjects} activePage="projects" lang={lang}>
    <div class="projects-intro">
        <div class="page-header">
            <a href={`/${lang}`} class="page-header__avatar" transition:name="profile-image" aria-label={t.about.title}>
                <Image src={meImg} alt="Felix Jonas Wiegleb" width={128} loading="eager" />
            </a>
            <h1 class="page-title">{t.projects.title}</h1>
        </div>
        <p class="page-subtitle">{t.projects.subtitle}</p>
    </div>

    <div class="projects-grid">
        {projects.map((project, i) => (
            <ProjectCard delay={i * 90} {...project} description={t.projects[project.transKey]}/>
        ))}
    </div>
</Layout>

<style>
    .projects-intro {
        margin-bottom: 2.5rem;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 768px) {
        .projects-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1280px) {
        .projects-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
