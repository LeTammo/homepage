---
import Layout from '../../layouts/Layout.astro';
import en from '../../../locales/en.json';
import de from '../../../locales/de.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const locales = { en, de };
const t = locales[lang] || en;
---

<Layout title={t.meta.titleImpressum} description={t.meta.descriptionImpressum} activePage="impressum" lang={lang}>
    <div class="impressum-intro">
        <h1 class="page-title impressum-title">{t.impressum.title}</h1>
        <div class="impressum-accent"></div>
    </div>

    <div class="impressum-content">
        <section class="impressum-card animate-fade-up">
            <h2 class="impressum-card__heading">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="impressum-card__icon">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                {t.impressum.ownerTitle}
            </h2>
            <div class="impressum-card__body">
                <p class="impressum-name">{t.impressum.name}</p>
                <p class="impressum-line">{t.impressum.addressLine1}</p>
                <p class="impressum-line">{t.impressum.addressLine2}</p>
                <p class="impressum-line">{t.impressum.addressLine3}</p>
            </div>
        </section>

        <section class="impressum-card animate-fade-up" style="animation-delay: 90ms">
            <h2 class="impressum-card__heading">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="impressum-card__icon">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                {t.impressum.contactTitle}
            </h2>
            <div class="impressum-card__links">
                <a href="mailto:fe-wiegleb@t-online.de" class="impressum-link">fe-wiegleb@t-online.de</a>
            </div>
        </section>

        <div class="impressum-grid">
            <section class="impressum-card animate-fade-up" style="animation-delay: 180ms">
                <h2 class="impressum-card__heading">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="impressum-card__icon">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                        <path d="M9 18c-4.51 2-5-2-7-2"></path>
                    </svg>
                    {t.impressum.Github}
                </h2>
                <a href="https://github.com/LeTammo/" target="_blank" class="impressum-link">@LeTammo</a>
            </section>

            <section class="impressum-card animate-fade-up" style="animation-delay: 180ms">
                <h2 class="impressum-card__heading">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="impressum-card__icon">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                        <rect width="4" height="12" x="2" y="9"></rect>
                        <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                    {t.impressum.LinkedIn}
                </h2>
                <a href="https://www.linkedin.com/in/jwiegleb" target="_blank" class="impressum-link">@jwiegleb</a>
            </section>
        </div>

        <a href={`/${lang}`} class="impressum-back animate-fade-up" style="animation-delay: 270ms">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            {t.impressum.backHome}
        </a>
    </div>
</Layout>

<style>
    .impressum-intro {
        margin-bottom: 2.5rem;
    }

    .impressum-title {
        margin-bottom: 1rem;
    }

    .impressum-accent {
        height: 0.25rem;
        width: 4rem;
        background: var(--text-accent);
        border-radius: var(--radius-sm);
    }

    .impressum-content {
        max-width: 42rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .impressum-card {
        background: var(--bg-surface-translucent);
        border: 1px solid var(--border-default);
        box-shadow: 0 4px 8px color-mix(in srgb, var(--border-default) 50%, transparent);
        border-radius: var(--radius-xl);
        padding: 1.5rem;
    }

    .impressum-card__heading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .impressum-card__icon {
        color: var(--text-accent);
        flex-shrink: 0;
    }

    .impressum-card__body {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .impressum-name {
        margin: 0;
        color: var(--text-primary);
        font-weight: 600;
    }

    .impressum-line {
        margin: 0;
        color: var(--text-tertiary);
    }

    .impressum-card__links {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .impressum-link {
        color: var(--text-tertiary);
        transition: color var(--transition-fast);
        width: fit-content;
    }

    .impressum-link:hover {
        color: var(--green-400);
    }

    .impressum-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    @media (min-width: 768px) {
        .impressum-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .impressum-back {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        transition: color var(--transition-fast);
        padding-top: 0.5rem;
        width: fit-content;
    }

    .impressum-back:hover {
        color: var(--green-400);
    }
</style>
