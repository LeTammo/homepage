<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>mathia.xyz</title>
    <meta http-equiv="refresh" content="0;url=/en/" />
    <script is:inline>
      function readCookie(name) {
        let m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
        return m ? decodeURIComponent(m[1]) : null;
      }
      let stored = readCookie('preferredLang');
      let targetLang;
      if (stored === 'de' || stored === 'en') {
        targetLang = stored;
      } else {
        let userLang = navigator.language || navigator.userLanguage || 'en';
        targetLang = userLang.toLowerCase().indexOf('de') === 0 ? 'de' : 'en';
      }
      window.location.replace('/' + targetLang + '/');
    </script>
  </head>
  <body style="background: #09090b; color: #a1a1aa; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
    <p>Redirecting / Weiterleitung...</p>
  </body>
</html>
