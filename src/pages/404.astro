---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | mathia.xyz" description="The page you're looking for doesn't exist." lang="en" trackLang={false}>
    <div class="text-center py-10 space-y-6">
        <p class="text-green-500 font-bold text-4xl">404</p>
        <div class="space-y-2">
            <h1 class="text-2xl md:text-3xl font-bold text-zinc-200">Page not found</h1>
            <p class="text-zinc-400/70">The page you're looking for doesn't exist or has moved.</p>
        </div>
        <div class="space-y-2">
            <h2 class="text-lg font-semibold text-zinc-200">Seite nicht gefunden</h2>
            <p class="text-zinc-400/70">Die gesuchte Seite existiert nicht oder wurde verschoben.</p>
        </div>
    </div>
    <script is:inline>
        try {
            let m = document.cookie.match(/(?:^|;\s*)preferredLang=([^;]*)/);
            let stored = m ? decodeURIComponent(m[1]) : null;
            let lang = stored === 'de' || stored === 'en' ? stored : 'de';
            window.location.replace('/' + lang + '/404/');
        } catch (e) {}
    </script>
</Layout>
