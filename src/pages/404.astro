---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | mathia.xyz" description="The page you're looking for doesn't exist." lang="en" trackLang={false}>
    <div class="error-page">
        <p class="error-code">404</p>
        <div class="error-block">
            <h1 class="error-title">Page not found</h1>
            <p class="error-description">The page you're looking for doesn't exist or has moved.</p>
        </div>
        <div class="error-block">
            <h2 class="error-subtitle">Seite nicht gefunden</h2>
            <p class="error-description">Die gesuchte Seite existiert nicht oder wurde verschoben.</p>
        </div>
    </div>
    <script is:inline>
        try {
            let m = document.cookie.match(/(?:^|;\s*)preferredLang=([^;]*)/);
            let stored = m ? decodeURIComponent(m[1]) : null;
            let lang = stored === 'de' || stored === 'en' ? stored : 'de';
            window.location.replace('/' + lang + '/404/');
        } catch (e) {}
    </script>
</Layout>
