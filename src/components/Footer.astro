---
const { lang, t } = Astro.props;
const currentPath = Astro.url.pathname;

const getLangPath = (targetLang) => {
  const match = currentPath.match(/^\/(en|de)(\/.*)?$/);
  if (match) {
    const subpath = match[2] || '';
    return `/${targetLang}${subpath}`;
  }
  return `/${targetLang}${currentPath}`;
};

const currentYear = new Date().getFullYear();
---
<div class="footer-bar">
    <div class="footer-inner">
        <div class="footer-left">
            <span class="footer-year">© {currentYear}</span>
            <span class="footer-sep">•</span>
            <a href={`/${lang}/impressum`} class="footer-link">
                {t.footer.impressum}
            </a>
        </div>

        <div class="footer-anim-group">
            <button class="footer-anim-btn" title="canvas animation">✦ {t.footer.animation} ✦</button>
            <div class="footer-anim-popup">
                <a href="https://github.com/LeTammo/homepage/blob/main/public/js/sketch.js" target="_blank" class="footer-anim-btn">
                    🔗 source
                </a>
                <span class="footer-anim-sep">•</span>
                <button class="footer-anim-btn" onclick="toggleColor()">✨ {t.footer.addColor}</button>
                <span class="footer-anim-sep">•</span>
                <button class="footer-anim-btn" onclick="toggleSpeed()">🔥 {t.footer.accelerate}</button>
            </div>
        </div>

        <div class="footer-right">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-globe">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
            </svg>
            <a href={getLangPath('de')} hreflang="de" aria-label="Deutsch" aria-current={lang === 'de' ? 'page' : undefined} class={`footer-lang ${lang === 'de' ? 'is-active' : ''}`}>DE</a>
            <span class="footer-slash">/</span>
            <a href={getLangPath('en')} hreflang="en" aria-label="English" aria-current={lang === 'en' ? 'page' : undefined} class={`footer-lang ${lang === 'en' ? 'is-active' : ''}`}>EN</a>
        </div>
    </div>
</div>

<style>
    .footer-bar {
        background: var(--bg-surface);
        border-top: 1px solid var(--border-default);
    }

    .footer-inner {
        width: 100%;
        margin-inline: auto;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    @media (min-width: 640px) {
        .footer-inner {
            max-width: 640px;
            padding: 0.75rem 1.5rem;
        }
    }

    @media (min-width: 768px) {
        .footer-inner {
            max-width: 768px;
        }
    }

    @media (min-width: 1024px) {
        .footer-inner {
            max-width: 1024px;
        }
    }

    @media (min-width: 1280px) {
        .footer-inner {
            max-width: 1280px;
        }
    }

    .footer-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        color: var(--text-faint);
        min-width: 0;
    }

    @media (min-width: 640px) {
        .footer-left {
            gap: 0.75rem;
            font-size: 0.875rem;
        }
    }

    .footer-year {
        flex-shrink: 0;
    }

    .footer-sep {
        color: var(--border-hover);
        display: none;
    }

    @media (min-width: 640px) {
        .footer-sep {
            display: inline;
        }
    }

    .footer-link {
        flex-shrink: 0;
        transition: color var(--transition-fast);
    }

    .footer-link:hover {
        color: var(--text-secondary);
    }

    .footer-anim-group {
        position: relative;
        display: none;
        align-items: center;
    }

    @media (min-width: 640px) {
        .footer-anim-group {
            display: flex;
        }
    }

    .footer-anim-btn {
        color: var(--text-muted);
        font-size: 0.72rem;
        transition: color 0.15s ease;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 1;
    }

    .footer-anim-btn:hover {
        color: var(--zinc-300);
    }

    .footer-anim-sep {
        color: var(--border-hover);
        font-size: 0.75rem;
        user-select: none;
    }

    .footer-anim-popup {
        position: absolute;
        bottom: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        background: var(--bg-surface-raised);
        border: 1px solid var(--border-hover);
        border-radius: var(--radius-md);
        padding: 7px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.18s ease, visibility 0.18s ease;
        z-index: 50;
    }

    .footer-anim-popup::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: var(--border-hover);
    }

    .footer-anim-group:hover .footer-anim-popup,
    .footer-anim-group:focus-within .footer-anim-popup {
        opacity: 1;
        visibility: visible;
    }

    .footer-right {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    @media (min-width: 640px) {
        .footer-right {
            gap: 0.5rem;
            font-size: 0.875rem;
        }
    }

    .footer-globe {
        color: var(--text-muted);
        display: none;
    }

    @media (min-width: 640px) {
        .footer-globe {
            display: block;
        }
    }

    .footer-lang {
        color: var(--text-muted);
        transition: color var(--transition-fast);
    }

    .footer-lang:hover {
        color: var(--text-secondary);
    }

    .footer-lang.is-active {
        color: var(--text-accent);
        font-weight: 700;
    }

    .footer-slash {
        color: var(--border-hover);
        user-select: none;
    }
</style>
