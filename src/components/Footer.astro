---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocalizedPath, useTranslations } from '../i18n.js';

const lang = Astro.currentLocale;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const currentYear = new Date().getFullYear();
---
<div class="footer-bar">
    <div class="footer-inner">
        <div class="footer-left">
            <span class="footer-year">© {currentYear}</span>
            <span class="footer-sep">•</span>
            <a href={getRelativeLocaleUrl(lang, 'impressum')} class="footer-link">
                {t.footer.impressum}
            </a>
        </div>

        <div class="footer-anim-group">
            <button type="button" class="footer-anim-btn footer-anim-toggle" title="canvas animation" aria-expanded="false" aria-controls="footer-anim-popup">✦ {t.footer.animation} ✦</button>
            <div class="footer-anim-popup" id="footer-anim-popup">
                <a href="https://github.com/LeTammo/homepage/blob/main/public/js/sketch.js" target="_blank" rel="noopener" class="footer-anim-btn">
                    🔗 source
                </a>
                <span class="footer-anim-sep">•</span>
                <button type="button" class="footer-anim-btn" onclick="toggleColor()">✨ {t.footer.addColor}</button>
                <span class="footer-anim-sep">•</span>
                <button type="button" class="footer-anim-btn" onclick="toggleSpeed()">🔥 {t.footer.accelerate}</button>
            </div>
        </div>

        <div class="footer-right">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-globe">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
            </svg>
            <a href={getLocalizedPath(currentPath, 'de')} hreflang="de" aria-label="Deutsch" aria-current={lang === 'de' ? 'page' : undefined} class={`footer-lang ${lang === 'de' ? 'is-active' : ''}`}>DE</a>
            <span class="footer-slash">/</span>
            <a href={getLocalizedPath(currentPath, 'en')} hreflang="en" aria-label="English" aria-current={lang === 'en' ? 'page' : undefined} class={`footer-lang ${lang === 'en' ? 'is-active' : ''}`}>EN</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('click', (event) => {
        const toggle = document.querySelector('.footer-anim-toggle');
        const target = event.target;
        if (!toggle || !(target instanceof Node)) return;
        const open = toggle.contains(target)
            ? toggle.getAttribute('aria-expanded') !== 'true'
            : !!toggle.parentElement?.contains(target) && toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(open));
    });
</script>

<style>
    .footer-bar {
        background: var(--bg-surface);
        border-top: 1px solid var(--border-default);
    }

    @media (min-width: 640px) {
        .footer-bar {
            border: 1px solid var(--border-default);
            border-radius: var(--radius-xl);
        }
    }

    .footer-inner {
        padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    @media (min-width: 640px) {
        .footer-inner {
            padding: 0.75rem 1.5rem;
        }
    }

    .footer-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        color: var(--text-faint);
        min-width: 0;
    }

    @media (min-width: 640px) {
        .footer-left {
            gap: 0.75rem;
            font-size: 0.875rem;
        }
    }

    .footer-year {
        flex-shrink: 0;
    }

    .footer-sep {
        color: var(--border-hover);
        display: none;
    }

    @media (min-width: 640px) {
        .footer-sep {
            display: inline;
        }
    }

    .footer-link {
        flex-shrink: 0;
        transition: color var(--transition-fast);
    }

    .footer-link:hover {
        color: var(--text-secondary);
    }

    .footer-anim-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .footer-anim-btn {
        color: var(--text-muted);
        font-size: 0.72rem;
        transition: color 0.15s ease;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 1;
    }

    .footer-anim-btn:hover {
        color: var(--zinc-300);
    }

    .footer-anim-sep {
        color: var(--border-hover);
        font-size: 0.75rem;
        user-select: none;
    }

    .footer-anim-popup {
        position: absolute;
        bottom: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        background: var(--bg-surface-raised);
        border: 1px solid var(--border-hover);
        border-radius: var(--radius-md);
        padding: 7px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.18s ease, visibility 0.18s ease;
        z-index: 50;
    }

    .footer-anim-popup::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: var(--border-hover);
    }

    @media (hover: hover) {
        .footer-anim-group:hover .footer-anim-popup,
        .footer-anim-group:focus-within .footer-anim-popup {
            opacity: 1;
            visibility: visible;
        }
    }

    .footer-anim-toggle[aria-expanded="true"] + .footer-anim-popup {
        opacity: 1;
        visibility: visible;
    }

    .footer-right {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    @media (min-width: 640px) {
        .footer-right {
            gap: 0.5rem;
            font-size: 0.875rem;
        }
    }

    .footer-globe {
        color: var(--text-muted);
        display: none;
    }

    @media (min-width: 640px) {
        .footer-globe {
            display: block;
        }
    }

    .footer-lang {
        color: var(--text-muted);
        transition: color var(--transition-fast);
    }

    .footer-lang:hover {
        color: var(--text-secondary);
    }

    .footer-lang.is-active {
        color: var(--text-accent);
        font-weight: 700;
    }

    .footer-slash {
        color: var(--border-hover);
        user-select: none;
    }
</style>
