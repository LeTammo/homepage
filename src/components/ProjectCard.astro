---
import { Image } from 'astro:assets';

const { title, icon, image, tags, description, github, demo, video, delay = 0 } = Astro.props;
const primary = demo || github;
---
<div class="project-card animate-fade-up" style={`animation-delay: ${delay}ms`}>
    <a href={primary} target="_blank" class="project-card__link" aria-label={title}></a>

    <div class="project-card__fade-h"></div>
    <div class="project-card__fade-v"></div>
    <div class="project-card__fade-solid"></div>

    {image && (
        <div class="project-card__media">
            <Image src={image} alt="" width={640} loading="lazy" class="project-card__media-img" />
        </div>
    )}

    <div class="project-card__header">
        {icon && (
            <div class="project-card__icon">
                <img src={icon} alt="" width="40" height="40" loading="lazy" class="project-card__icon-img" />
            </div>
        )}
        <div class="project-card__actions">
            {github && (
                <a href={github} target="_blank" title="GitHub" class="project-card__action">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                        <path d="M9 18c-4.51 2-5-2-7-2"></path>
                    </svg>
                </a>
            )}
            {demo && (
                <a href={demo} target="_blank" title="Live Demo" class="project-card__action">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" x2="21" y1="14" y2="3"></line>
                    </svg>
                </a>
            )}
            {video && (
                <a href={video} target="_blank" title="YouTube" class="project-card__action">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
                        <path d="m10 15 5-3-5-3z"></path>
                    </svg>
                </a>
            )}
        </div>
    </div>

    <div class="project-card__title-row">
        <h3 class="project-card__title">{title}</h3>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="project-card__arrow">
            <path d="M5 12h14m0 0l-6-6m6 6l-6 6"></path>
        </svg>
    </div>

    <p class="project-card__description">{description}</p>

    <p class="project-card__tags">{tags.join(' · ')}</p>
</div>

<style>
    .project-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        background: var(--bg-surface-translucent);
        transition: all var(--transition-slow);
    }

    .project-card:hover {
        background: var(--bg-surface-hover-translucent);
        border-color: var(--border-accent);
    }

    .project-card__link {
        position: absolute;
        inset: 0;
    }

    .project-card__fade-h,
    .project-card__fade-v,
    .project-card__fade-solid {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 7rem;
    }

    .project-card__fade-h {
        z-index: -9;
        margin-right: 24%;
        background: linear-gradient(to right, transparent, var(--bg-surface));
    }

    .project-card__fade-v {
        z-index: -8;
        background: linear-gradient(to bottom, transparent, var(--bg-surface));
    }

    .project-card__fade-solid {
        z-index: -7;
        margin-left: 76%;
        background: var(--bg-surface);
    }

    .project-card__media {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 7rem;
        z-index: -10;
        pointer-events: none;
        user-select: none;
        transition: var(--transition-slow);
        mask-image: linear-gradient(to bottom, black, transparent);
        -webkit-mask-image: linear-gradient(to bottom, black, transparent);
    }

    .project-card__media-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
    }

    .project-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .project-card__icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .project-card__icon-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border-radius: var(--radius-lg);
        background: var(--bg-surface-raised);
        box-shadow: 0 4px 6px color-mix(in srgb, var(--bg-surface-raised) 50%, transparent);
    }

    .project-card__actions {
        position: relative;
        z-index: 10;
        display: flex;
        gap: 0.25rem;
    }

    .project-card__action {
        padding: 0.5rem;
        border-radius: var(--radius-lg);
        color: var(--text-muted);
        background: var(--bg-surface);
        border: 1px solid color-mix(in srgb, var(--text-muted) 20%, transparent);
        box-shadow: 0 4px 6px color-mix(in srgb, var(--text-muted) 50%, transparent);
        transition: background-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .project-card__action:hover {
        background: var(--bg-surface-hover);
        color: var(--text-accent);
        box-shadow: 0 4px 6px var(--text-accent);
    }

    .project-card__title-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .project-card__title {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-secondary);
        transition: color var(--transition-fast);
    }

    .project-card:hover .project-card__title {
        color: var(--green-400);
    }

    .project-card__arrow {
        color: var(--green-400);
        opacity: 0;
        transform: translateX(-0.25rem);
        transition: all var(--transition-base);
    }

    .project-card:hover .project-card__arrow {
        opacity: 0.9;
        transform: translateX(0);
    }

    .project-card__description {
        font-size: 0.875rem;
        color: var(--text-faint);
        line-height: 1.625;
        margin-top: 0.5rem;
        margin-bottom: 0;
        flex-grow: 1;
    }

    .project-card__tags {
        font-size: 0.875rem;
        color: var(--text-accent-muted);
        margin-top: 1rem;
        margin-bottom: 0;
    }
</style>
