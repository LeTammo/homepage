---
const {lang, t} = Astro.props;
const L = (v) => (typeof v === 'string' ? v : v[lang] || v.en);

const softSkills = [t.about.soft1, t.about.soft2, t.about.soft3, t.about.soft4, t.about.soft5];

const categories = [
    {
        title: {de: 'Softwareentwicklung (Backend)', en: 'Software Development (Backend)'},
        skills: [
            {abbr: 'PHP', name: 'PHP', detail: '7.4 - 8.x · Symfony', from: '#06b6d4', to: '#3b82f6'},
            {abbr: 'J', name: 'Java', detail: 'Spring Boot', from: '#10b981', to: '#16a34a'},
            {abbr: 'PY', name: 'Python', detail: 'Flask', from: '#22d3ee', to: '#0891b2'},
            {abbr: 'N', name: 'Node.js', detail: 'Express, REST APIs', from: '#16a34a', to: '#047857'},
            {abbr: 'DB', name: {de: 'Datenbanken', en: 'Databases'}, detail: 'MySQL, MariaDB, SQLite', from: '#4f46e5', to: '#9333ea'},
            {abbr: 'API', name: {de: 'Architektur', en: 'Architecture'}, detail: 'REST APIs, OOP', from: '#64748b', to: '#475569'},
        ],
    },
    {
        title: {de: 'Arbeitsmethodik & KI', en: 'Work methodology & AI'},
        skills: [
            {
                abbr: 'PM', from: '#16a34a', to: '#047857',
                name: {de: 'Projektmanagement', en: 'Project Management'},
                detail: {de: 'Kommunikation', en: 'Communication'}
            },
            {
                abbr: 'AG', from: '#14b8a6', to: '#0891b2',
                name: {de: 'Agile Methoden', en: 'Agile Methods'},
                detail: {de: 'Moderation', en: 'Moderation'}
            },
            {
                abbr: 'M', from: '#6366f1', to: '#2563eb',
                name: {de: 'Mathematik', en: 'Mathematics'},
                detail: {de: 'Optimierung', en: 'Optimization'}
            },
            {
                abbr: 'AI', from: '#ec4899', to: '#f43f5e', name: 'LLM APIs',
                detail: {de: 'Claude, GPT-Modelle', en: 'Claude, GPT models'}
            },
            {abbr: 'PE', from: '#f59e0b', to: '#f97316', name: 'Prompt Engineering', detail: 'LLM Optimization'},
            {abbr: 'LLM', from: '#7c3aed', to: '#c026d3', name: 'On-Premise AI', detail: 'Local LLMs'},
        ],
    },
    {
        title: {de: 'Softwareentwicklung (Frontend)', en: 'Software Development (Frontend)'},
        skills: [
            {abbr: 'JS', from: '#3b82f6', to: '#2563eb', name: 'JavaScript', detail: 'TypeScript'},
            {abbr: 'CSS', from: '#38bdf8', to: '#3b82f6', name: 'HTML & CSS', detail: 'Custom CSS'},
            {abbr: 'R', from: '#8b5cf6', to: '#9333ea', name: 'React.js', detail: 'Component-Based'},
            {abbr: '{ }', from: '#64748b', to: '#475569', name: 'Templating', detail: 'Twig, Pug, Handlebars'},
        ],
    },
    {
        title: {de: 'DevOps, Hosting & Systeme', en: 'DevOps, Hosting & Systems'},
        skills: [
            {abbr: 'DC', from: '#2563eb', to: '#0ea5e9', name: 'Docker', detail: 'Containerization'},
            {abbr: 'NX', from: '#10b981', to: '#14b8a6', name: 'NGINX & DNS', detail: 'Self-Hosting'},
            {abbr: 'G', from: '#f97316', to: '#dc2626', name: 'Git', detail: 'CI/CD, GitHub'},
            {
                abbr: 'OS', from: '#64748b', to: '#475569',
                name: {de: 'Betriebssysteme', en: 'Operating Systems'},
                detail: 'Linux, Windows, macOS'
            },
        ],
    },
];
---
<div class="skills">
    <div class="skills__soft animate-fade-up">
        {softSkills.map((item) => (
                <span class="soft-skill">
                <svg class="soft-skill__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="soft-skill__label">{item}</span>
            </span>
        ))}
    </div>
    <div class="skills__categories">
        {categories.map((category, i) => (
            <div class="animate-fade-up" style={`animation-delay: ${90 + i * 90}ms`}>
                <h3 class="category-title">
                    <span class="category-title__index">{String(i + 1).padStart(2, '0')}</span>
                    {L(category.title)}
                </h3>
                <div class="category-grid">
                    {category.skills.map((skill) => (
                        <div class="skill-card">
                            <div class="skill-card__inner">
                                <div class="skill-card__badge" style={`background: linear-gradient(to bottom right, ${skill.from}, ${skill.to})`}>
                                    {skill.abbr}
                                </div>
                                <div class="skill-card__text">
                                    <div class="skill-card__name">{L(skill.name)}</div>
                                    {skill.detail && <div class="skill-card__detail">{L(skill.detail)}</div>}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .skills {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .skills__soft {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.5rem;
        padding-top: 0.5rem;
    }

    @media (min-width: 640px) {
        .skills__soft {
            flex-direction: row;
            flex-wrap: wrap;
        }
    }

    @media (min-width: 1024px) {
        .skills__soft {
            padding-inline: 10%;
        }
    }

    @media (min-width: 1280px) {
        .skills__soft {
            padding-inline: 0;
        }
    }

    .soft-skill {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        width: 100%;
        min-width: 0;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-full);
        border: 1px solid color-mix(in srgb, var(--border-hover) 50%, transparent);
        font-size: 0.75rem;
        color: var(--text-tertiary);
    }

    @media (min-width: 640px) {
        .soft-skill {
            width: auto;
        }
    }

    .soft-skill__icon {
        width: 0.75rem;
        height: 0.75rem;
        color: var(--text-accent);
        flex-shrink: 0;
    }

    .soft-skill__label {
        overflow-wrap: break-word;
    }

    .skills__categories {
        display: grid;
        grid-template-columns: 1fr;
        column-gap: 2rem;
        row-gap: 2.5rem;
    }

    @media (min-width: 1024px) {
        .skills__categories {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .category-title {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--text-tertiary);
    }

    @media (min-width: 1024px) {
        .category-title {
            border-bottom: 1px solid var(--border-default);
        }
    }

    .category-title__index {
        color: var(--zinc-650);
    }

    .category-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.5rem;
    }

    @media (min-width: 400px) {
        .category-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 768px) {
        .category-grid {
            gap: 0.75rem;
        }
    }

    .skill-card {
        padding: 0.5rem;
        background: var(--bg-surface-hover);
        border-radius: var(--radius-lg);
        transition: all var(--transition-base);
    }

    @media (min-width: 768px) {
        .skill-card {
            padding: 0.75rem;
        }
    }

    .skill-card:hover {
        background: var(--border-hover);
        box-shadow: var(--shadow-lg);
    }

    .skill-card__inner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        height: 100%;
    }

    .skill-card__badge {
        width: 2rem;
        height: 2rem;
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    @media (min-width: 1280px) {
        .skill-card__badge {
            width: 2.5rem;
            height: 2.5rem;
        }
    }

    .skill-card__text {
        min-width: 0;
    }

    .skill-card__name {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.75rem;
    }

    @media (min-width: 1280px) {
        .skill-card__name {
            font-size: 1rem;
        }
    }

    .skill-card__detail {
        font-size: 0.7rem;
        line-height: 1rem;
        color: var(--text-tertiary);
    }
</style>
