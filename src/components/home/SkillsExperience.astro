---
import { categories } from '../../data/skills.js';

const {t} = Astro.props;

const softSkills = [t.about.soft1, t.about.soft2, t.about.soft3, t.about.soft4, t.about.soft5];
---
<div class="skills">
    <div class="skills__soft animate-fade-up">
        {softSkills.map((item) => (
                <span class="soft-skill">
                <svg class="soft-skill__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="soft-skill__label">{item}</span>
            </span>
        ))}
    </div>
    <div class="skills__categories">
        {categories.map((category, i) => (
            <div class="animate-fade-up" style={`animation-delay: ${90 + i * 90}ms`}>
                <h3 class="category-title">
                    <span class="category-title__index">{String(i + 1).padStart(2, '0')}</span>
                    {t.skills[category.transKey]}
                </h3>
                <div class="category-grid">
                    {category.skills.map((skill) => {
                        const skillText = t.skills[skill.transKey];
                        return (
                            <div class="skill-card">
                                <div class="skill-card__inner">
                                    <div class="skill-card__badge" style={`background: linear-gradient(to bottom right, ${skill.from}, ${skill.to})`}>
                                        {skillText.abbr}
                                    </div>
                                    <div class="skill-card__text">
                                        <div class="skill-card__name">{skillText.name}</div>
                                        <div class="skill-card__detail">{skillText.detail}</div>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .skills {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .skills__soft {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.5rem;
        padding-top: 0.5rem;
    }

    @media (min-width: 640px) {
        .skills__soft {
            flex-direction: row;
            flex-wrap: wrap;
        }
    }

    @media (min-width: 1024px) {
        .skills__soft {
            padding-inline: 10%;
        }
    }

    @media (min-width: 1280px) {
        .skills__soft {
            padding-inline: 0;
        }
    }

    .soft-skill {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        width: 100%;
        min-width: 0;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-full);
        border: 1px solid color-mix(in srgb, var(--border-hover) 50%, transparent);
        font-size: 0.75rem;
        color: var(--text-tertiary);
    }

    @media (min-width: 640px) {
        .soft-skill {
            width: auto;
        }
    }

    .soft-skill__icon {
        width: 0.75rem;
        height: 0.75rem;
        color: var(--text-accent);
        flex-shrink: 0;
    }

    .soft-skill__label {
        overflow-wrap: break-word;
    }

    .skills__categories {
        display: grid;
        grid-template-columns: 1fr;
        column-gap: 2rem;
        row-gap: 2.5rem;
    }

    @media (min-width: 1024px) {
        .skills__categories {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .category-title {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--text-tertiary);
    }

    @media (min-width: 1024px) {
        .category-title {
            border-bottom: 1px solid var(--border-default);
        }
    }

    .category-title__index {
        color: var(--zinc-650);
    }

    .category-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.5rem;
    }

    @media (min-width: 400px) {
        .category-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 768px) {
        .category-grid {
            gap: 0.75rem;
        }
    }

    .skill-card {
        padding: 0.5rem;
        background: var(--bg-surface-hover);
        border-radius: var(--radius-lg);
        transition: all var(--transition-base);
    }

    @media (min-width: 768px) {
        .skill-card {
            padding: 0.75rem;
        }
    }

    .skill-card:hover {
        background: var(--border-hover);
        box-shadow: var(--shadow-lg);
    }

    .skill-card__inner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        height: 100%;
    }

    .skill-card__badge {
        width: 2rem;
        height: 2rem;
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    @media (min-width: 1280px) {
        .skill-card__badge {
            width: 2.5rem;
            height: 2.5rem;
        }
    }

    .skill-card__text {
        min-width: 0;
    }

    .skill-card__name {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.75rem;
    }

    @media (min-width: 1280px) {
        .skill-card__name {
            font-size: 1rem;
        }
    }

    .skill-card__detail {
        font-size: 0.7rem;
        line-height: 1rem;
        color: var(--text-tertiary);
    }
</style>
