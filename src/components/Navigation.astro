---
const { activePage, lang, t } = Astro.props;
---
<nav aria-label="Main" class="nav">
    <ul class="nav-list">
        <li>
            <a href={`/${lang}`} class={`nav-link ${activePage === 'home' ? 'is-active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                    <circle cx="12" cy="8" r="5"></circle>
                    <path d="M20 21a8 8 0 0 0-16 0"></path>
                </svg>
                <span class="nav-link-label">{t.nav.about}</span>
            </a>
        </li>

        <li>
            <a href={`/${lang}/projects`} class={`nav-link ${activePage === 'projects' ? 'is-active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.3.09-3.1a2.18 2.18 0 0 0-3.11-.1z"></path>
                    <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                </svg>
                <span class="nav-link-label">{t.nav.projects}</span>
            </a>
        </li>

        <li>
            <a href={`/${lang}/berufserfahrung`} class={`nav-link ${activePage === 'berufserfahrung' ? 'is-active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                    <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <span class="nav-link-label">{t.nav.experience}</span>
            </a>
        </li>
    </ul>
</nav>

<style>
    .nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        gap: 1.5rem;
    }

    @media (min-width: 1280px) {
        .nav {
            align-items: flex-start;
        }
    }

    .nav-list {
        display: flex;
        justify-content: center;
        width: 100%;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    @media (min-width: 640px) {
        .nav-list {
            gap: 0.5rem;
        }
    }

    @media (min-width: 1280px) {
        .nav-list {
            gap: 2rem;
        }
    }

    .nav-link {
        display: flex;
        align-items: center;
        width: 100%;
        padding: 0.25rem 0.5rem;
        border-radius: var(--radius-md);
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-tertiary);
        transition: all var(--transition-slow);
    }

    @media (min-width: 640px) {
        .nav-link {
            padding: 0.5rem 0.75rem;
        }
    }

    .nav-link:hover {
        color: var(--zinc-100);
        background: var(--bg-surface-hover-translucent);
    }

    .nav-link.is-active {
        color: var(--text-accent);
        background: color-mix(in srgb, var(--zinc-800) 60%, transparent);
    }

    .nav-link-icon {
        margin-right: 0.25rem;
    }

    @media (min-width: 640px) {
        .nav-link-icon {
            margin-right: 0.625rem;
        }
    }

    .nav-link-label {
        font-size: 0.875rem;
    }

    @media (min-width: 768px) {
        .nav-link-label {
            font-size: 1rem;
        }
    }
</style>
