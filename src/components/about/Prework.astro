---
const { t } = Astro.props;
---
<h3 class="text-lg font-bold text-zinc-300 mb-6 flex items-center animate-fade-up">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-green-600">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
    </svg>
    {t.about.prework}
</h3>

<div class="space-y-8 relative pl-4 border-l border-zinc-800">
    <div class="relative animate-fade-up" style="animation-delay: 150ms">
        <div class="absolute -left-5.5 top-[4.5px] w-3 h-3 bg-zinc-650 rounded-full border-2 border-zinc-900 mt-1"></div>
        <div class="space-y-1">
            <span class="text-sm text-zinc-500 font-semibold uppercase tracking-wider">12.2018 – 07.2020</span>
            <h4 class="font-bold text-md text-zinc-400">{t.about.workEzgs}</h4>
            <p class="text-sm text-zinc-400">Erich-Zeigner-Grundschule Leipzig</p>
            <ul class="text-sm text-zinc-500 list-disc pl-4 space-y-1 pt-1">
                <li>{t.about.workEzgs_1}</li>
                <li>{t.about.workEzgs_2}</li>
                <li>{t.about.workEzgs_3}</li>
            </ul>
        </div>
    </div>

    <div class="relative animate-fade-up" style="animation-delay: 210ms">
        <div class="absolute -left-5.5 top-[4.5px] w-3 h-3 bg-zinc-650 rounded-full border-2 border-zinc-900 mt-1"></div>
        <div class="space-y-1">
            <span class="text-sm text-zinc-500 font-semibold uppercase tracking-wider">03.2016 – 08.2020</span>
            <h4 class="font-bold text-md text-zinc-400">{t.about.workNachhilfe}</h4>
            <p class="text-sm text-zinc-400">{t.about.workNachhilfe_org}</p>
            <ul class="text-sm text-zinc-500 list-disc pl-4 space-y-1 pt-1">
                <li>{t.about.workNachhilfe_1}</li>
                <li>{t.about.workNachhilfe_2}</li>
            </ul>
        </div>
    </div>

    <div class="relative animate-fade-up" style="animation-delay: 270ms">
        <div class="absolute -left-5.5 top-[4.5px] w-3 h-3 bg-zinc-650 rounded-full border-2 border-zinc-900 mt-1"></div>
        <div class="space-y-1">
            <span class="text-sm text-zinc-500 font-semibold uppercase tracking-wider">2018 – 2020</span>
            <h4 class="font-bold text-md text-zinc-400">{t.about.workPromoter}</h4>
            <p class="text-sm text-zinc-400">Wort in Tat UG · Leipzig</p>
            <ul class="text-sm text-zinc-500 list-disc pl-4 space-y-1 pt-1">
                <li>{t.about.workPromoter_1}</li>
                <li>{t.about.workPromoter_2}</li>
            </ul>
        </div>
    </div>

    <div class="relative animate-fade-up" style="animation-delay: 330ms">
        <div class="absolute -left-5.5 top-[4.5px] w-3 h-3 bg-zinc-650 rounded-full border-2 border-zinc-900 mt-1"></div>
        <div class="space-y-1">
            <span class="text-sm text-zinc-500 font-semibold uppercase tracking-wider">11.2016 – 09.2017</span>
            <h4 class="font-bold text-md text-zinc-400">{t.about.workSHK}</h4>
            <p class="text-sm text-zinc-400">HTWK Leipzig · Prof. Dr. Grüttmüller</p>
            <ul class="text-sm text-zinc-500 list-disc pl-4 space-y-1 pt-1">
                <li>{t.about.workSHK_1}</li>
                <li>{t.about.workSHK_2}</li>
                <li>{t.about.workSHK_3}</li>
            </ul>
        </div>
    </div>
</div>
