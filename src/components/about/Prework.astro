---
const { t } = Astro.props;
---
<h3 class="timeline-heading animate-fade-up">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="timeline-heading-icon">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
    </svg>
    {t.about.prework}
</h3>

<div class="timeline">
    <div class="timeline-item animate-fade-up" style="animation-delay: 150ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">12.2018 – 07.2020</span>
            <h4 class="timeline-title">{t.about.workEzgs}</h4>
            <p class="timeline-subtitle">Erich-Zeigner-Grundschule Leipzig</p>
            <ul class="timeline-notes">
                <li>{t.about.workEzgs_1}</li>
                <li>{t.about.workEzgs_2}</li>
                <li>{t.about.workEzgs_3}</li>
            </ul>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 210ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">03.2016 – 08.2020</span>
            <h4 class="timeline-title">{t.about.workNachhilfe}</h4>
            <p class="timeline-subtitle">{t.about.workNachhilfe_org}</p>
            <ul class="timeline-notes">
                <li>{t.about.workNachhilfe_1}</li>
                <li>{t.about.workNachhilfe_2}</li>
            </ul>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 270ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">2018 – 2020</span>
            <h4 class="timeline-title">{t.about.workPromoter}</h4>
            <p class="timeline-subtitle">Wort in Tat UG · Leipzig</p>
            <ul class="timeline-notes">
                <li>{t.about.workPromoter_1}</li>
                <li>{t.about.workPromoter_2}</li>
            </ul>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 330ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">11.2016 – 09.2017</span>
            <h4 class="timeline-title">{t.about.workSHK}</h4>
            <p class="timeline-subtitle">HTWK Leipzig · Prof. Dr. Grüttmüller</p>
            <ul class="timeline-notes">
                <li>{t.about.workSHK_1}</li>
                <li>{t.about.workSHK_2}</li>
                <li>{t.about.workSHK_3}</li>
            </ul>
        </div>
    </div>
</div>
