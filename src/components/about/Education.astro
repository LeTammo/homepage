---
const { t } = Astro.props;
---
<h3 class="timeline-heading animate-fade-up">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="timeline-heading-icon">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
    </svg>
    {t.about.education}
</h3>

<div class="timeline">
    <div class="timeline-item animate-fade-up" style="animation-delay: 150ms">
        <div class="timeline-dot timeline-dot--accent"></div>
        <div class="timeline-body">
            <span class="timeline-date timeline-date--accent">2020 – 2024</span>
            <h4 class="timeline-title">{t.about.educationBachelor}</h4>
            <p class="timeline-subtitle">FH Aachen</p>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 210ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">2020 – 2023</span>
            <h4 class="timeline-title">{t.about.educationMATSE}</h4>
            <p class="timeline-subtitle">Databay AG</p>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 270ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">2014 – 2020</span>
            <h4 class="timeline-title">{t.about.educationHTWK}</h4>
            <p class="timeline-subtitle">HTWK Leipzig ({t.about.noDegree})</p>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 330ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">2012 – 2014</span>
            <h4 class="timeline-title">{t.about.educationSchool}</h4>
            <p class="timeline-subtitle">BSZ 7 Leipzig</p>
        </div>
    </div>
</div>
