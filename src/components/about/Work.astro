---
const { t } = Astro.props;
---
<h3 class="timeline-heading animate-fade-up">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="timeline-heading-icon">
        <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
    </svg>
    {t.about.work}
</h3>

<div class="timeline">
    <div class="timeline-item animate-fade-up" style="animation-delay: 150ms">
        <div class="timeline-dot timeline-dot--accent"></div>
        <div class="timeline-body">
            <span class="timeline-date timeline-date--accent">{t.about.workPresent} 06.2025</span>
            <h4 class="timeline-title">{t.about.workPHP_Ilias}</h4>
            <p class="timeline-subtitle">Databay AG · Team ILIAS</p>
            <ul class="timeline-notes">
                <li><span class="timeline-notes__label">{t.about.workPHP_Ilias_1}:</span> {t.about.workPHP_Ilias_1_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workPHP_Ilias_2}:</span> {t.about.workPHP_Ilias_2_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workPHP_Ilias_3}:</span> {t.about.workPHP_Ilias_3_detail_pre}<a href="https://www.youtube.com/watch?v=ZHiWC_dz-k0" target="_blank" rel="noopener" class="timeline-link">{t.about.workPHP_Ilias_3_detail_link}</a>{t.about.workPHP_Ilias_3_detail_post}</li>
            </ul>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 210ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">01.2024 – 05.2025</span>
            <h4 class="timeline-title">{t.about.workPHP_Seminar}</h4>
            <p class="timeline-subtitle">Databay AG · Team Seminarmanagement</p>
            <ul class="timeline-notes">
                <li><span class="timeline-notes__label">{t.about.workPHP_Seminar_1}:</span> {t.about.workPHP_Seminar_1_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workPHP_Seminar_2}:</span> {t.about.workPHP_Seminar_2_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workPHP_Seminar_3}:</span> {t.about.workPHP_Seminar_3_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workPHP_Seminar_4}:</span> {t.about.workPHP_Seminar_4_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workPHP_Seminar_5}:</span> {t.about.workPHP_Seminar_5_detail}</li>
            </ul>
        </div>
    </div>

    <div class="timeline-item animate-fade-up" style="animation-delay: 270ms">
        <div class="timeline-dot"></div>
        <div class="timeline-body">
            <span class="timeline-date">09.2020 – 12.2023</span>
            <h4 class="timeline-title">{t.about.workMATSE}</h4>
            <p class="timeline-subtitle">Databay AG · Team Seminarmanagement</p>
            <ul class="timeline-notes">
                <li><span class="timeline-notes__label">{t.about.workMATSE_1}:</span> {t.about.workMATSE_1_detail}</li>
                <li><span class="timeline-notes__label">{t.about.workMATSE_2}:</span> {t.about.workMATSE_2_detail}</li>
            </ul>
        </div>
    </div>
</div>
